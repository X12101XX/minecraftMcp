{
  "name": "minecraft-mcp-server",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "MCP stdio server for the Minecraft MCP Fabric bridge (read, build, verify real worlds)",
  "bin": {
    "minecraft-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/",
    "start": "node dist/index.js",
    "test:negative": "node test/negative.mjs",
    "test:preload": "node test/preload.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:player": "node test/player_house.mjs",
    "test:integrated": "node test/integrated.mjs",
    "test:batch-errors": "node test/batch_errors.mjs",
    "test:cancel": "node test/cancel.mjs",
    "test:scale": "node test/region_large.mjs && node test/terrain_large.mjs",
    "check:site": "node tools/check-site.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/X12101XX/minecraftMcp.git"
  },
  "homepage": "https://github.com/X12101XX/minecraftMcp",
  "keywords": [
    "minecraft",
    "fabric",
    "mcp",
    "model-context-protocol",
    "agent",
    "build"
  ],
  "files": [
    "dist/",
    "tools/",
    "README.md"
  ]
}
